    <string>/Users/klodel</string>
    <key>USER</key>
    <string>klodel</string>
    <key>TZ</key>
    <string>Europe/Budapest</string>
    <key>MARVEEN_STORE</key>
    <string>/Users/klodel/marveen/store</string>
  </dict>
</dict>
</plist>
